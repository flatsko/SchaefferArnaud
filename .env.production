# Variables d'environnement pour la production sur o2switch
# Toutes les variables doivent commencer par VITE_ pour être accessibles côté client

# URL de l'API backend (à adapter selon votre configuration)
# Si backend sur o2switch :
# VITE_API_URL=https://votre-domaine.com/api
# Si backend externe :
# VITE_API_URL=https://votre-backend.herokuapp.com/api
VITE_API_URL=http://localhost:5000/api

# Clés Stripe pour la production
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_votre_cle_stripe_live

# Autres configurations
VITE_APP_NAME="Arnaud Schaeffer"
VITE_APP_VERSION="1.0.0"
VITE_ENVIRONMENT="production"

# Configuration EmailJS (si utilisé)
# VITE_EMAILJS_SERVICE_ID=votre_service_id
# VITE_EMAILJS_TEMPLATE_ID=votre_template_id
# VITE_EMAILJS_PUBLIC_KEY=votre_public_key